{
  "name": "Daily Network Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*) as total_transactions, sum(final_price) as total_volume FROM transactions WHERE created_at > NOW() - INTERVAL '1 day';"
      },
      "name": "Postgres Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-db",
          "name": "Supabase DB"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const data = items[0].json;\nreturn [{\n  json: {\n    text: `Daily Report (${new Date().toLocaleDateString()}):\n    \n    Total Transactions: ${data.total_transactions}\n    Total Volume: $${data.total_volume || 0}\n    \n    System Health: 99.9% Uptime`\n  }\n}];"
      },
      "name": "Format Report",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "reports@logisticsmesh.com",
        "toEmail": "admin@logisticsmesh.com",
        "subject": "Daily Network Report - {{new Date().toLocaleDateString()}}",
        "text": "={{$node[\"Format Report\"].json[\"text\"]}}"
      },
      "name": "Email Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "Postgres Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Query": {
      "main": [
        [
          {
            "node": "Format Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Report": {
      "main": [
        [
          {
            "node": "Email Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
